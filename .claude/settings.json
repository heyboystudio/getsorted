{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(php artisan:*)",
      "Bash(composer check:*)",
      "Bash(composer test:*)",
      "Bash(composer install:*)",
      "Bash(composer dump-autoload:*)",
      "Bash(composer audit:*)",
      "Bash(./vendor/bin/pest:*)",
      "Bash(./vendor/bin/pint:*)",
      "Bash(./vendor/bin/phpstan:*)",
      "Bash(./vendor/bin/rector:*)",
      "Bash(npm run:*)",
      "Bash(npm ci:*)",
      "Bash(npm audit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)"
    ],
    "ask": [
      "Bash(composer require:*)",
      "Bash(composer remove:*)",
      "Bash(composer update:*)",
      "Bash(npm install:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(php artisan migrate:fresh:*)",
      "Bash(php artisan db:seed:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./.env.testing)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(php artisan db:wipe:*)",
      "Bash(php artisan migrate:fresh --env=production:*)",
      "Bash(php artisan migrate --env=production:*)",
      "Bash(rm -rf /:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v jq >/dev/null 2>&1 || exit 0; f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.php) cd \"$CLAUDE_PROJECT_DIR\" && [ -x vendor/bin/pint ] && vendor/bin/pint --quiet \"$f\" ;; esac; exit 0"
          }
        ]
      }
    ]
  }
}
