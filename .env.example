APP_NAME=GetSorted
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=getsorted
DB_USERNAME=getsorted
# Local-only password for the Docker database in compose.yaml (bound to 127.0.0.1).
DB_PASSWORD=getsorted_local
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MEDIA_DISK=media
MAIL_MAILER=log

# Address autocomplete (spec 015); restrict the key to Places API (New)
GOOGLE_MAPS_API_KEY=

# Web push (spec 022): VAPID keys for pop-up notifications. Leave empty to switch push off.
# Generate a pair with: php artisan webpush:vapid
VAPID_SUBJECT=mailto:hello@usesorted.co.za
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
